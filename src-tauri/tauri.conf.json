{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanMusic",
  "version": "0.1.0",
  "identifier": "com.lanmusic.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: cover: http://cover.localhost; media-src 'self' music: http://music.localhost blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5QzIzRTQ3MjJFNzAyRkQKUldUOUF1Y2lSejdDZVRBQXhIcUY2ZWl2TlZwbytNVXJiWllkN1FMQyt3Q1U5aXRBZEVwdUxaS1AK",
      "endpoints": [
        "https://github.com/hengrong1/lanmusic/releases/latest/download/latest.json"
      ]
    }
  }
}
